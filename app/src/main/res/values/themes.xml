<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#73F7D4</item>
        <item name="colorOnPrimary">#11172B</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">#101B35</item>
        <item name="android:statusBarColor">#080D1E</item>
        <item name="android:navigationBarColor">#080D1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_gold</item>
