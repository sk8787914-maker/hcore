<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_frost_glass_card"
    android:elevation="16dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="32dp"
    android:paddingEnd="28dp"
    android:paddingBottom="32dp">

    <!-- Top App Logo -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_logo_inner"
        android:clipToOutline="true"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/logo" />

    <!-- 3 Dots Indeterminate Loader -->
    <ProgressBar
        android:id="@+id/iosSpinner"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:indeterminate="true"
        android:indeterminateTint="#0F172A" />

    <!-- Main Title -->
    <TextView
        android:id="@+id/loadingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="Verifying..."
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtext -->
    <TextView
        android:id="@+id/loadingSubtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Please wait, verifying owner key"
        android:textColor="#64748B"
        android:textSize="13sp" />
</LinearLayout>
